{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run build)",
      "Bash(node --experimental-strip-types:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(next dev)",
      "Bash(npx next dev:*)",
      "Bash(pnpm dev)",
      "Bash(yarn dev)",
      "Bash(bun dev)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dev-server.sh\"",
            "statusMessage": "Checking command is not a dev server…"
          }
        ]
      }
    ]
  }
}
